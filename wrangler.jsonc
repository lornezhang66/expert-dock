{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expert-dock",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "ed.lorne.top", "custom_domain": true }
  ],
  "vars": {
    "MAX_UPLOAD_BYTES": "20971520",
    "HELPER_VERSION": "0.8.0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "expert-dock",
      "database_id": "2267365e-04e3-4933-beba-0cd3ae9396c7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PACKAGES",
      "bucket_name": "expert-dock-packages"
    }
  ]
}
